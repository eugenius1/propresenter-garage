{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "packages/web/src/i18n/provider.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "packages/core/**",
        "packages/mcp/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "react/*",
                  "react-dom/*",
                  "lucide-react",
                  "@radix-ui/*",
                  "vite-plugin-pwa",
                  "virtual:pwa-register*",
                  "@propresenter-garage/web",
                  "@propresenter-garage/web/*"
                ],
                "message": "core and mcp hold no UI: npm hoists every package, so this would resolve, and the server bundle would carry the app. Put it in packages/web."
              }
            ]
          }
        ]
      }
    }
  ]
}

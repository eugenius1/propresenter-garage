{
  "name": "propresenter-garage",
  "private": true,
  "version": "0.0.0",
  "description": "A suite of utilities for ProPresenter 7 files. Runs entirely in your browser.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "protos": "node scripts/build-descriptor.mjs",
    "protos:update": "node scripts/update-protos.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dev": "npm run protos && vite",
    "build": "npm run protos && tsc -b tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json",
    "report": "tsx src/report.mts",
    "check": "npm run protos && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "protobufjs": "^8.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
